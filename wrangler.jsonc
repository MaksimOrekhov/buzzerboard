{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "buzzerboard",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-11-16",
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "NBA_DB",
      "database_name": "buzzerboard-nba-cache",
      "database_id": "ab82a06b-3311-41cc-b93c-9af5e92208e4",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "DUNKAPI_REFRESH_ENABLED": "false",
    "DUNKAPI_BOX_SCORE_REFRESH_ENABLED": "false",
    "BBS_REFRESH_ENABLED": "true",
    "BBS_PLAYERS_ENABLED": "true",
    "BBS_PLAYER_REFRESH_ENABLED": "false",
    "BBS_DAILY_REQUEST_LIMIT": "150",
    "BBS_REQUEST_HEADROOM": "25",
    "BBS_PER_MINUTE_REQUEST_LIMIT": "10",
    "NBA_GAMES_PROVIDER_ORDER": "bbs",
    "NBA_STANDINGS_PROVIDER_ORDER": "bbs",
  },
}

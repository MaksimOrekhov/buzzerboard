{
  "name": "buzzerboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" index.html package.json tsconfig.json vite.config.ts uno.config.ts eslint.config.js .github/workflows/ci.yml README.md .prettierrc.json pnpm-lock.yaml",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" index.html package.json tsconfig.json vite.config.ts uno.config.ts eslint.config.js .github/workflows/ci.yml README.md .prettierrc.json pnpm-lock.yaml"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.0.0",
    "@unocss/reset": "^66.13.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0",
    "unocss": "^66.13.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "vue-demi"
    ]
  }
}
